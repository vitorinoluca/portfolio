---
const navItems = [
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Stack', href: '#stack' },
  { label: 'Sobre mí', href: '#sobre-mi' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header
  id="top"
  class="sticky top-0 z-20 backdrop-blur-[10px]"
  style="background: color-mix(in srgb, var(--color-bg) 82%, transparent);"
>
  <div class="mx-auto flex max-w-[1100px] flex-wrap items-center gap-x-7 gap-y-3.5 px-5 py-3.5 sm:px-8">
    <a href="#top" class="mr-auto text-base font-medium tracking-tight text-(--color-text)">
      Luca Vitorino
    </a>

    <nav class="hidden gap-x-5 gap-y-2.5 md:flex" aria-label="Principal">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-[13px] no-underline hover:text-(--color-accent)"
            style="color: color-mix(in srgb, var(--color-text) 62%, transparent);"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-11 w-11 flex-none items-center justify-center md:hidden"
      aria-label="Menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-6 w-6">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="invisible grid grid-rows-[0fr] transition-[grid-template-rows,visibility] duration-300 ease-[cubic-bezier(0.23,1,0.32,1)] md:hidden"
  >
    <nav class="flex min-h-0 flex-col overflow-hidden px-5 pb-[22px] pt-2 sm:px-8" aria-label="Principal (mobile)">
      {
        navItems.map((item, i) => (
          <a
            href={item.href}
            class:list={[
              'py-[13px] text-base no-underline',
              { 'border-b': i < navItems.length - 1 },
            ]}
            style={`border-color: color-mix(in srgb, var(--color-text) 10%, transparent);`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const mq = window.matchMedia('(max-width: 760px)');
  let open = false;

  function setOpen(next: boolean) {
    open = next;
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('grid-rows-[0fr]', !open);
    menu?.classList.toggle('grid-rows-[1fr]', open);
    menu?.classList.toggle('invisible', !open);
  }

  toggle?.addEventListener('click', () => setOpen(!open));
  mq.addEventListener('change', (e) => {
    if (!e.matches) setOpen(false);
  });

  // Scrollea a la sección sin tocar la URL (sin agregar #hash a la ruta).
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const id = link.getAttribute('href')!.slice(1);
      e.preventDefault();
      if (id === 'top') {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        const target = document.getElementById(id);
        target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      setOpen(false);
    });
  });
</script>
