---
import SectionHeading from './SectionHeading.astro';

const projects = [
  {
    meta: '2026 · Diseño, backend y frontend',
    name: 'facturador-arca',
    description:
      'Facturación electrónica (ARCA/WSFEv1) para monotributistas. Los usuarios delegan la facturación en el CUIT de la app y emiten facturas C reales sin gestionar certificados propios.',
    stack: ['NestJS', 'PostgreSQL', 'Next.js', 'AFIP SDK'],
    demoUrl: 'https://app.fluxify.site',
    repoUrl: 'https://github.com/vitorinoluca/facturador-arca',
  },
  {
    meta: '2025 · Backend y modelo de datos',
    name: 'payments-platform',
    description:
      'Plataforma de pagos P2P con ledger de doble entrada, locking pesimista para transferencias simultáneas, idempotencia y un motor de detección de fraude por reglas.',
    stack: ['NestJS', 'PostgreSQL', 'Redis', 'Socket.io'],
    demoUrl: 'https://payments-platform-zeta.vercel.app/test.html',
    repoUrl: 'https://github.com/vitorinoluca/payments-platform',
  },
  {
    meta: '2025 · Fullstack y autenticación',
    name: 'localhost:forum',
    description:
      'Foro web con hilos, comentarios anidados y reacciones. Autenticación propia con verificación por email, JWT en cookies httpOnly y hashing Argon2.',
    stack: ['React', 'Express', 'PostgreSQL', 'Supabase Storage'],
    demoUrl: 'https://localhost-forum.onrender.com',
    repoUrl: 'https://github.com/vitorinoluca/localhost-forum',
  },
];
---

<section id="proyectos" class="mx-auto max-w-[1100px] scroll-mt-20 px-5 pt-[clamp(72px,12vw,128px)] sm:px-8" data-reveal>
  <SectionHeading
    title="Proyectos"
    description="Trabajos personales."
  />

  {
    projects.map((project, i) => (
      <article
        class="grid grid-cols-[repeat(auto-fit,minmax(290px,1fr))] items-start gap-[clamp(24px,4vw,40px)]"
        style={`margin-top: ${i === 0 ? 'clamp(36px,7vw,56px)' : 'clamp(56px,10vw,88px)'};`}
      >
        <div class:list={{ 'md:order-2': i === 1 }}>
          <p class="text-xs uppercase tracking-[0.1em] text-(--color-accent-400)">{project.meta}</p>
          <h3 class="mt-2 text-[28px] tracking-[-0.02em]">{project.name}</h3>
          <p
            class="mt-3 text-base leading-[1.7]"
            style="color: color-mix(in srgb, var(--color-text) 80%, transparent);"
          >
            {project.description}
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {project.stack.map((s) => (
              <span class="tag tag-neutral">{s}</span>
            ))}
          </div>
          <div class="mt-7 flex flex-wrap gap-2.5">
            <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Demo
            </a>
            <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              Repo
            </a>
          </div>
        </div>
        <div
          class:list={['overflow-hidden rounded-[14px] shadow-(--shadow-sm)', { 'md:order-1': i === 1 }]}
          style="aspect-ratio: 16 / 10;"
        >
          <img
            src={`/projects/${project.name.replace(':', '-')}.png`}
            alt={`Captura de ${project.name}`}
            class:list={['h-full w-full object-cover', { 'object-left': project.name === 'payments-platform' }]}
            loading="lazy"
          />
        </div>
      </article>
    ))
  }
</section>
