---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
  <h2 class="tracking-[-0.02em]" style="font-size: clamp(28px, 3.2vw, 38px);">{title}</h2>
  <p class="text-[13px]" style="color: color-mix(in srgb, var(--color-text) 55%, transparent);">
    {description}
  </p>
</div>
<hr class="hr" />
