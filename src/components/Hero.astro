---

---

<section class='relative overflow-hidden py-[clamp(64px,14vw,132px)]'>
  <div
    class='pointer-events-none absolute left-[-120px] top-5 h-[440px] w-[560px]'
    style='background: radial-gradient(closest-side, color-mix(in srgb, var(--color-accent) 15%, transparent), transparent);'
    aria-hidden='true'
  >
  </div>

  <div class='relative mx-auto max-w-[1100px] px-5 sm:px-8'>
    <h1
      class='whitespace-nowrap font-medium leading-[0.94] tracking-[-0.035em]'
      style='font-size: clamp(26px, 6.5vw, 92px);'
    >
      Luca Valentin Vitorino
    </h1>

    <div
      class='mt-[26px] grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] items-start gap-[clamp(32px,5vw,56px)]'
    >
      <div>
        <p
          class='max-w-[24ch] leading-[1.25] text-(--color-accent-300)'
          style='font-size: clamp(20px, 2.4vw, 28px);'
        >
          Fullstack developer | Next.js & NestJS.
        </p>
        <div class='mt-[clamp(28px,5vw,44px)] flex flex-wrap gap-3.5'>
          <a
            href='/cv-vitorino.pdf'
            target='_blank'
            rel='noopener noreferrer'
            class='btn btn-primary'
          >
            Descargar CV
          </a>
          <a
            href='mailto:valentinvitorino28@gmail.com'
            class='btn btn-secondary'>Escribime</a
          >
        </div>
      </div>

      <div class='flex flex-col items-start gap-[22px]'>
        <p
          class='text-base leading-[1.7] text-(--color-text)'
          style='color: color-mix(in srgb, var(--color-text) 76%, transparent); text-wrap: pretty;'
        >
          +4 años de experiencia. Desarrollador de Software y Estudiante de
          Sistemas de Buenos Aires, Argentina. Especializado en el desarrollo de
          aplicaciones web.
        </p>
        <div class='flex flex-col gap-2 text-[13px]'>
          <a
            href='https://github.com/vitorinoluca'
            target='_blank'
            rel='noopener noreferrer'
            class='flex items-center gap-1.5 hover:text-(--color-accent) hover:underline'
          >
            <svg viewBox='0 0 24 24' fill='currentColor' class='h-4 w-4 flex-none'>
              <path
                d='M12 .5C5.73.5.5 5.73.5 12c0 5.02 3.26 9.28 7.79 10.78.57.1.78-.25.78-.55 0-.27-.01-1-.02-1.96-3.17.69-3.84-1.53-3.84-1.53-.52-1.31-1.27-1.66-1.27-1.66-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.33.95.1-.74.4-1.24.72-1.53-2.53-.29-5.2-1.27-5.2-5.65 0-1.25.44-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.39-2.68 5.36-5.22 5.64.41.36.77 1.06.77 2.15 0 1.55-.01 2.8-.01 3.18 0 .3.21.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z'
              />
            </svg>
            github.com/vitorinoluca
          </a>
          <a
            href='https://linkedin.com/in/luca-vitorino'
            target='_blank'
            rel='noopener noreferrer'
            class='flex items-center gap-1.5 hover:text-(--color-accent) hover:underline'
          >
            <svg viewBox='0 0 24 24' fill='currentColor' class='h-4 w-4 flex-none'>
              <path
                d='M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.44-2.14 2.94v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z'
              />
            </svg>
            linkedin.com/in/luca-vitorino
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
